# Environment Mode (set automatically by host or npm scripts)
# NODE_ENV=production

# Server Port (PaaS hosts like Render/Railway/Heroku supply PORT automatically)
PORT=5000

# MongoDB Connection String
# For MongoDB Atlas (Production Cloud Database):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dsa-vault?retryWrites=true&w=majority&appName=DSAVault
# For Local / Self-Hosted MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-vault

# MongoDB Connection Pool (for high concurrent users)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# JWT Secret (Generate a strong 64+ char random string, e.g. using: openssl rand -base64 48)
JWT_SECRET=change-this-to-a-super-secret-random-key-in-production

# CORS Allowed Origins (Comma-separated if multiple, e.g., https://yourdomain.com,https://app.yourdomain.com)
# In unified single-host deployment, leave unset or set to your frontend domain
CLIENT_ORIGIN=http://localhost:5173
